# Browser-safe Supabase configuration
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Optional: only set if your frontend is hosted separately from the API
# VITE_API_URL=https://your-api.example.com/api

# The local Node server automatically reads .env.local.
# For the backend you may use the same values above:
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Server-only. Recommended for system notifications and privileged internal writes.
# Never prefix this with VITE_.
SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVER_ONLY_KEY
